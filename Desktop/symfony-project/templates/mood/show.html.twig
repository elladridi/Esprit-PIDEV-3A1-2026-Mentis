{% extends 'base.html.twig' %}

{% block title %}Mood Details{% endblock %}

{% block body %}
<div class="wellness-dashboard py-5">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-5">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_mood_index') }}" class="text-spotify fw-bold">Mood Tracker</a></li>
                <li class="breadcrumb-item active text-dark">{{ mood.feeling|replace({'_': ' '})|capitalize }}</li>
            </ol>
        </nav>

        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="mood-main-card">
                    <div class="card-header-black">
                        <div class="mood-hero-icon">
                            {% if mood.feeling == 'very_happy' %}
                                <i class="far fa-laugh-beam text-success"></i>
                            {% elseif mood.feeling == 'happy' %}
                                <i class="far fa-smile text-info"></i>
                            {% elseif mood.feeling == 'neutral' %}
                                <i class="far fa-meh text-secondary"></i>
                            {% elseif mood.feeling == 'sad' %}
                                <i class="far fa-frown text-warning"></i>
                            {% elseif mood.feeling == 'very_sad' %}
                                <i class="far fa-sad-tear text-danger"></i>
                            {% endif %}
                        </div>
                        <h1 class="display-3 fw-800 mb-0 text-capitalize">{{ mood.feeling|replace({'_': ' '}) }}</h1>
                        <p class="opacity-75 fs-5">Logged {{ mood.createdAt ? mood.createdAt|time_ago : '' }}</p>
                    </div>

                    <div class="p-5">
                        <div class="mb-5">
                            <h5 class="text-uppercase fw-800 small letter-spacing-1 mb-3">Your Reflection</h5>
                            <div class="note-container">
                                "{{ mood.note }}"
                            </div>
                        </div>

                        {% if mood.recommendedTrackUrl %}
                            <div class="spotify-player-premium">
                                <div class="track-artwork-large me-5 d-flex align-items-center justify-content-center bg-black rounded-circle shadow-lg" style="width: 120px; height: 120px;">
                                    <i class="fab fa-spotify text-success fa-5x"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="text-spotify fw-800 small text-uppercase mb-2">Recommended for your mood</div>
                                    <h2 class="display-6 fw-800 mb-1 text-white">{{ mood.recommendedTrackName }}</h2>
                                    <h4 class="opacity-75 mb-4 text-white">{{ mood.recommendedArtistName }}</h4>
                                    
                                    <div class="d-flex gap-3 align-items-center">
                                        <a href="{{ mood.recommendedTrackUrl }}" target="_blank" class="btn btn-spotify btn-lg">
                                            <i class="fab fa-spotify me-2"></i>OPEN IN SPOTIFY
                                        </a>
                                        {% if mood.recommendedPreviewUrl %}
                                            <audio controls class="spotify-audio-player" style="height: 40px; border-radius: 20px;">
                                                <source src="{{ mood.recommendedPreviewUrl }}" type="audio/mpeg">
                                            </audio>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        <div class="mt-5 pt-4 border-top d-flex gap-3">
                            <a href="{{ path('app_mood_edit', {'id': mood.id}) }}" class="btn btn-dark btn-lg px-5 rounded-pill fw-bold">EDIT LOG</a>
                            <form method="post" action="{{ path('app_mood_delete', {'id': mood.id}) }}" onsubmit="return confirm('Are you sure you want to delete this log?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ mood.id) }}">
                                <button class="btn btn-outline-danger btn-lg px-5 rounded-pill fw-bold">DELETE</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --spotify-green: #1DB954;
        --spotify-black: #000000;
        --spotify-dark-grey: #121212;
        --spotify-grey: #f8f9fa;
        --text-main: #000000;
    }

    .wellness-dashboard {
        background: #ffffff;
        min-height: 100vh;
        color: var(--text-main);
    }

    .mood-main-card {
        background-color: #ffffff;
        border-radius: 24px;
        border: 2px solid #f0f0f0;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,0.05);
    }

    .card-header-black {
        background: var(--spotify-black);
        padding: 40px;
        color: white;
        text-align: center;
    }

    .mood-hero-icon { 
        font-size: 7rem; 
        margin-bottom: 20px;
        filter: drop-shadow(0 10px 20px rgba(0,0,0,0.2));
    }
    
    .note-container {
        background: #f8f9fa;
        border-left: 6px solid var(--spotify-green);
        padding: 30px;
        border-radius: 12px;
        font-style: italic;
        font-size: 1.4rem;
        color: #121212;
    }

    .spotify-player-premium {
        background: var(--spotify-green);
        border-radius: 20px;
        padding: 30px;
        color: white;
        display: flex;
        align-items: center;
        margin-top: 40px;
        border: 2px solid rgba(0,0,0,0.1);
    }

    .track-artwork-large {
        width: 120px;
        height: 120px;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    .btn-spotify {
        background-color: var(--spotify-green);
        color: white;
        border: none;
        border-radius: 50px;
        font-weight: 700;
        padding: 12px 30px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .text-spotify { color: var(--spotify-green); }
</style>
{% endblock %}
