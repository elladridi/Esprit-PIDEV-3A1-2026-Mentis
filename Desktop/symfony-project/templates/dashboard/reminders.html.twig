{% extends 'base.html.twig' %}

{% block title %}Reminder Center{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="h2 text-primary mb-4">Reminder Center</h1>

    <div class="row">
        <div class="col-lg-10 mx-auto">
            {% for notif in notifications %}
                <div class="card border-0 shadow-sm rounded-4 mb-3 p-3 {% if not notif.isRead %}border-start border-primary border-4{% endif %}">
                    <div class="d-flex align-items-center">
                        <div class="notif-icon me-4">
                            {% if notif.type == constant('App\\Entity\\WellnessNotification::TYPE_DAILY_MOOD_REMINDER') %}
                                <i class="fas fa-smile fa-2x text-info"></i>
                            {% elseif notif.type == constant('App\\Entity\\WellnessNotification::TYPE_GOAL_DEADLINE_REMINDER') %}
                                <i class="fas fa-bullseye fa-2x text-warning"></i>
                            {% elseif notif.type == constant('App\\Entity\\WellnessNotification::TYPE_WEEKLY_SUMMARY') %}
                                <i class="fas fa-chart-line fa-2x text-success"></i>
                            {% endif %}
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <h5 class="fw-bold mb-0 text-capitalize">{{ notif.type|replace({'_': ' '}) }}</h5>
                                <small class="text-muted">{{ notif.createdAt|date('M d, H:i') }}</small>
                            </div>
                            <p class="text-dark mb-0">{{ notif.content|nl2br }}</p>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-bell-slash fa-3x mb-3 opacity-25"></i>
                    <h3>All caught up!</h3>
                    <p>No notifications for you at the moment.</p>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
